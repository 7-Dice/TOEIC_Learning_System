-- 2) questions
-- ============================================================

INSERT INTO questions (
    passage_id,
    part_type,
    question_text,
    option_a,
    option_b,
    option_c,
    option_d,
    correct_answer,
    explanation
) VALUES

-- Part 5: independent short questions
(NULL, 5, 'The manager asked the team to ____ the report before the deadline.', 'finish', 'finished', 'finishes', 'finishing', 'A', 'The structure "ask someone to do something" requires the base form of the verb.'),
(NULL, 5, 'The new software is expected to ____ processing time significantly.', 'reduce', 'reduces', 'reduced', 'reducing', 'A', 'After "expected to", the base form of the verb is used.'),
(NULL, 5, 'Because the shipment was delayed, the customer became ____.', 'upset', 'upsetting', 'upsets', 'upsetted', 'A', 'The adjective "upset" describes the customer’s emotional state.'),
(NULL, 5, 'The company is preparing for a major ____ into overseas markets.', 'expansion', 'expand', 'expanded', 'expanding', 'A', 'The article "a" is followed by a noun.'),
(NULL, 5, 'The meeting was postponed ____ next Monday because of bad weather.', 'until', 'for', 'at', 'in', 'A', 'Use "until" to indicate the point in time.'),
(NULL, 5, 'We can offer a discount if you sign the contract ____ week.', 'this', 'that', 'these', 'those', 'A', '"This week" refers to the current week.'),
(NULL, 5, 'The office will be closed for renovation ____ the summer.', 'during', 'under', 'between', 'across', 'A', 'Use "during" to refer to a period of time.'),
(NULL, 5, 'Please confirm whether you received the package ____.', 'yesterday', 'soon', 'later', 'already', 'A', 'A specific past time calls for "yesterday".'),
(NULL, 5, 'The engineers completed the project ____ schedule.', 'ahead of', 'behind', 'toward', 'beside', 'A', '"Ahead of schedule" is the normal phrase.'),
(NULL, 5, 'The sales department has been working long hours ____ month.', 'this', 'those', 'that', 'these', 'A', '"This month" refers to the current month.'),

